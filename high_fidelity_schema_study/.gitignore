.mypy_cache/
.coverage

# Local agent/runtime state.
.omx/

# Local scratch / rendered previews.
tmp/

# LaTeX build intermediates. Rendered paper PDFs remain versioned.
paper/build/*.aux
paper/build/*.bbl
paper/build/*.blg
paper/build/*.log
paper/build/*.out

# Presentation build dependencies are reproducible from the runtime.
docs/presentation/node_modules/

# Downloaded external raw payloads are large and reproducible from manifests.
