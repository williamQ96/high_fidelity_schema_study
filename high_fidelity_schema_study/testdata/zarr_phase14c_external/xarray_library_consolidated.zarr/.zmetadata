{
    "metadata": {
        ".zattrs": {
            "Conventions": "CF-1.8",
            "title": "Xarray generated Phase 14C reference dataset"
        },
        ".zgroup": {
            "zarr_format": 2
        },
        "latitude/.zarray": {
            "chunks": [
                3
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<f4",
            "fill_value": "NaN",
            "filters": null,
            "order": "C",
            "shape": [
                3
            ],
            "zarr_format": 2
        },
        "latitude/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "latitude"
            ],
            "axis": "Y",
            "standard_name": "latitude",
            "units": "degrees_north"
        },
        "longitude/.zarray": {
            "chunks": [
                5
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<f4",
            "fill_value": "NaN",
            "filters": null,
            "order": "C",
            "shape": [
                5
            ],
            "zarr_format": 2
        },
        "longitude/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "longitude"
            ],
            "axis": "X",
            "standard_name": "longitude",
            "units": "degrees_east"
        },
        "station/.zarray": {
            "chunks": [
                2
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<i4",
            "fill_value": null,
            "filters": null,
            "order": "C",
            "shape": [
                2
            ],
            "zarr_format": 2
        },
        "station/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "station"
            ]
        },
        "station_name/.zarray": {
            "chunks": [
                2
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "|O",
            "fill_value": null,
            "filters": [
                {
                    "id": "vlen-utf8"
                }
            ],
            "order": "C",
            "shape": [
                2
            ],
            "zarr_format": 2
        },
        "station_name/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "station"
            ],
            "long_name": "station label"
        },
        "temperature/.zarray": {
            "chunks": [
                1,
                3,
                5
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<f4",
            "fill_value": "NaN",
            "filters": null,
            "order": "C",
            "shape": [
                4,
                3,
                5
            ],
            "zarr_format": 2
        },
        "temperature/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "time",
                "latitude",
                "longitude"
            ],
            "coordinates": "time latitude longitude",
            "standard_name": "air_temperature",
            "units": "K"
        },
        "time/.zarray": {
            "chunks": [
                4
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<i8",
            "fill_value": null,
            "filters": null,
            "order": "C",
            "shape": [
                4
            ],
            "zarr_format": 2
        },
        "time/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "time"
            ],
            "axis": "T",
            "calendar": "standard",
            "standard_name": "time",
            "units": "hours since 2024-01-01 00:00:00"
        }
    },
    "zarr_consolidated_format": 1
}